# Copy to .env.local and fill in.

# Admin login (one shared password). Use something long.
ADMIN_PASSWORD=change-me
# Random secret used to sign the login cookie, at least 32 characters.
# Generate one with:  openssl rand -base64 48
ADMIN_SESSION_SECRET=

# Supabase (Project Settings → API). Leave empty for local dev to store data in .data/calculators.json.
# The service-role key is only used on the server. Never expose it with a NEXT_PUBLIC_ prefix.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
